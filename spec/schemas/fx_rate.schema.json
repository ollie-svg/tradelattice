{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradelattice.dev/schemas/v0.2/fx_rate.schema.json",
  "title": "FxRate",
  "description": "An exchange rate: multiply an amount in currency by rate to get an amount in to. CAD is the Canadian convention for to, but it is not enforced.",
  "allOf": [
    {"$ref": "https://tradelattice.dev/schemas/v0.2/envelope.schema.json"},
    {
      "properties": {
        "type": {"const": "fx_rate"},
        "attributes": {
          "type": "object",
          "required": ["currency", "to", "rate", "on"],
          "additionalProperties": false,
          "properties": {
            "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
            "to": {"type": "string", "pattern": "^[A-Z]{3}$"},
            "rate": {"type": "string", "pattern": "^-?\\d+(\\.\\d+)?$", "description": "Multiply a currency amount by this to get the to amount."},
            "on": {"type": "string", "format": "date"},
            "publisher": {"type": "string", "minLength": 1, "description": "e.g. boc."}
          }
        }
      }
    }
  ]
}
