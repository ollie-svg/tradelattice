{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradelattice.dev/schemas/v0.2/surtax_order.schema.json",
  "title": "SurtaxOrder",
  "description": "One line of a surtax order: a percentage of value for duty applied to goods of a given origin whose tariff code starts with hs_prefix, for a date range.",
  "allOf": [
    {"$ref": "https://tradelattice.dev/schemas/v0.2/envelope.schema.json"},
    {
      "properties": {
        "type": {"const": "surtax_order"},
        "attributes": {
          "type": "object",
          "required": ["hs_prefix", "origin_country", "pct", "list_id", "effective_from", "effective_to"],
          "additionalProperties": false,
          "properties": {
            "hs_prefix": {"type": "string", "pattern": "^[0-9]{2,10}$"},
            "origin_country": {"type": "string", "pattern": "^[A-Z]{2}$"},
            "pct": {"type": "string", "pattern": "^-?\\d+(\\.\\d+)?$", "description": "Percentage of value for duty, as a decimal string."},
            "list_id": {"type": "string", "minLength": 1},
            "effective_from": {"type": "string", "format": "date"},
            "effective_to": {"type": ["string", "null"], "format": "date"},
            "source_url": {"type": "string", "format": "uri"}
          }
        }
      }
    }
  ]
}
